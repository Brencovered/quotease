# Supabase — create a project at supabase.com, run supabase/schema.sql in its SQL editor
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend — for the "send quote" email feature. Sign up at resend.com,
# verify a sending domain, create an API key.
RESEND_API_KEY=
RESEND_FROM_EMAIL=quotes@yourdomain.com

# Xero — register a developer app at developer.xero.com/app/manage.
# Set the redirect URI there to exactly match XERO_REDIRECT_URI below.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=https://your-deployment.vercel.app/api/xero/callback

# Stripe — $40/mo flat or $400/yr, unlimited users, 7-day trial.
# Create the two recurring Prices in the Stripe dashboard first (Products > Add product),
# then paste their price IDs (not product IDs) below.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
NEXT_PUBLIC_APP_URL=https://your-deployment.vercel.app

# Vercel AI Gateway - powers blog outline assist, drawing analysis, voice
# quote, and chat. Production can auth via OIDC, but an explicit key is the
# reliable path (and required for local / non-Vercel runs).
# Dashboard: AI Gateway > API Keys > create key > set as AI_GATEWAY_API_KEY.
# If blog "Plan an outline" 500s, this is almost always unset or the key
# cannot use the configured models.
AI_GATEWAY_API_KEY=

# Legacy direct Anthropic key - no longer used by app routes (everything
# goes through the AI Gateway). Kept so old checklists don't confuse people
# into thinking drawing-analysis still needs it.
# ANTHROPIC_API_KEY=

# PostHog — product analytics, separate from GA4 (marketing funnel) above.
# Get the project API key at app.posthog.com > Project Settings > API Keys
# (the "Project API Key", safe to expose client-side — do not use a
# "Personal API Key" here, those are private and server-side only).
# POSTHOG_REGION must match whichever cloud region was picked at signup —
# check Project Settings > Project in the PostHog dashboard if unsure.
# Wrong region means every event silently fails to send.
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_REGION=us

# Server-side PostHog read access, separate from the ingestion key
# above - used to sync per-listing traffic stats for the tradie-facing
# dashboard (Settings > Directory). Create a *Personal* API Key at
# app.posthog.com > Settings > Personal API Keys with "query:read"
# scope (the opposite of the note above - this one specifically must
# be a Personal API Key, not the Project API Key). POSTHOG_PROJECT_ID
# is the numeric ID visible in the PostHog project URL
# (app.posthog.com/project/<this number>). Both required together -
# the traffic sync cron logs a clear error and does nothing until both
# are set, rather than failing silently.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Stripe Price ID for the AI drawing-analysis add-on: $10/mo, no trial
# (the 3 free analyses already serve that purpose). Create this Price the
# same way as the main monthly/annual prices.
STRIPE_PRICE_AI_ADDON=

# Supabase service role key — required by the Stripe webhook to update
# subscription status (it has no logged-in user, so it can't use the anon key).
# Find this in Supabase: Project Settings > API > service_role key.
# NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis — backs cross-instance rate limiting on the AI/vision routes.
# Easiest path: Vercel dashboard > Storage > Create Database > Upstash Redis
# (Marketplace integration), which auto-populates these two vars in the
# project's env vars. Without these set, rate limiting still works but only
# per-serverless-instance, not globally across concurrent cold starts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
